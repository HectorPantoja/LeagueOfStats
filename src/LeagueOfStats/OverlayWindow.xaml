<Window x:Class="LeagueOfStats.OverlayWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="LeagueOfStats · jugador y equipo" Width="440" SizeToContent="Height" MaxHeight="650"
        Topmost="True" ShowInTaskbar="False" ShowActivated="False" WindowStyle="None"
        ResizeMode="NoResize" AllowsTransparency="True" Background="Transparent" Left="30" Top="100">
  <Border Background="#E1101B2A" CornerRadius="12" Padding="16">
    <ScrollViewer VerticalScrollBarVisibility="Auto">
      <StackPanel>
        <TextBlock Text="JUGADOR ACTIVO · EQUIPO ALIADO" FontWeight="Bold" Foreground="LightSkyBlue"/>
        <TextBlock Text="{Binding Live.Status}" Foreground="White" TextWrapping="Wrap" Margin="0,6,0,0"/>
        <TextBlock Text="{Binding Live.ActivePlayer}" Foreground="White" TextWrapping="Wrap" Margin="0,6,0,0"/>
        <TextBlock Text="{Binding Live.Stats}" Foreground="White" TextWrapping="Wrap" Margin="0,6,0,0"/>
        <ItemsControl ItemsSource="{Binding Live.TeamPlayers}" Margin="0,12,0,0">
          <ItemsControl.ItemTemplate>
            <DataTemplate>
              <TextBlock Foreground="White" TextWrapping="Wrap" Margin="0,3">
                <TextBlock.Text>
                  <MultiBinding StringFormat="{}{0} · {1} · Nv {2} · {3} · CS {4}">
                    <Binding Path="Name"/>
                    <Binding Path="Player.Champion"/>
                    <Binding Path="Player.Level"/>
                    <Binding Path="Kda"/>
                    <Binding Path="Player.CreepScore"/>
                  </MultiBinding>
                </TextBlock.Text>
              </TextBlock>
            </DataTemplate>
          </ItemsControl.ItemTemplate>
        </ItemsControl>
      </StackPanel>
    </ScrollViewer>
  </Border>
</Window>

